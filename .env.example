# Copy to .env and fill in. Never commit real values.

# Neon Postgres. sslmode=verify-full is what pg already does for "require"
# today; spelling it out keeps that behavior and silences the pg SSL warning.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Cloudflare R2 (chapter pages, posters, uploads)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
# Custom domain connected to the bucket (R2 > bucket > Settings > Custom Domains),
# no trailing slash. Not the r2.dev address, which is rate-limited and for testing.
R2_PUBLIC_URL="https://yumeimg.com"
# Optional, comma-separated: older hosts that stored rows may still use until
# scripts/rewrite-image-hosts.mjs has rewritten them, e.g. the old r2.dev URL.
R2_LEGACY_PUBLIC_URLS=""

# Google Drive import (admin)
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""

# Salt for hashing reader IPs (free-chapter limits). Any long random string.
IP_HASH_SECRET=""
