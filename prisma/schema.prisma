generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MangaStatus {
  ONGOING
  COMPLETED
  CATCHING_UP
  STOPPED
}

enum UserRole {
  READER
  ADMIN
}

enum SubscriptionPlan {
  TWO_WEEKS
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

// ─── Core content ─────────────────────────────────────────────────────────────

model Manga {
  id          String      @id @default(nanoid())
  mangaName   String
  description String?
  coverImage  String?
  homeCoverImage   String?
  detailCoverImage String?
  // Curated related images the reader can pick as their personal cover.
  posterOptions    String[] @default([])
  // Admin-chosen default poster (one of posterOptions). Falls back to
  // detailCoverImage/coverImage when null.
  defaultPoster    String?
  titleFont   String?
  author      String?
  artist      String?
  status      MangaStatus @default(ONGOING)
  // Owner-curated homepage hero ("Юмэгийн санал болгох"). Only isFeatured
  // rows appear, sorted by featuredOrder ascending (nulls last).
  isFeatured    Boolean @default(false)
  featuredOrder Int?
  // How many of this series' newest chapters are subscriber-only. Null falls
  // back to PAYWALLED_LATEST_CHAPTERS in lib/plans.
  paywalledChapters Int?
  // Total chapter opens, signed in or not. Drives the "Топ 10 үзэлттэй манга"
  // rail; the raw number is admin-only.
  viewCount   Int         @default(0)
  // Distinct readers who have opened at least one chapter. Denormalised from
  // ReadingProgress so the detail page never runs COUNT DISTINCT to render;
  // maintained on first read and rebuildable with scripts/backfill-reader-counts.mjs.
  readerCount Int         @default(0)
  // Homepage promo banner. A 3:1 image the owner supplies per series, shown in
  // one of four fixed homepage slots (1–4, see HomeLanding). A banner with no
  // slot is kept but not shown; the unique index allows one banner per slot.
  // Separate from isFeatured, which drives the cover-art hero.
  promoImageUrl String?
  promoSlot     Int?        @unique
  // Superseded by promoSlot (the slot migration copied its order across).
  // Kept so no data is dropped; nothing reads it any more.
  promoOrder    Int?
  // Completion reward. Setting this is what makes the series give a reward:
  // readers who open every published chapter get the background once.
  // rewardBackgroundUrl is the compressed display copy; the original upload
  // is kept alongside it for the reader's "download original" button.
  rewardBackgroundUrl         String?
  rewardBackgroundOriginalUrl String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  chapters        Chapter[]
  genres          MangaGenre[]
  ratings         Rating[]
  bookmarks       Bookmark[]
  comments        Comment[]
  readingProgress ReadingProgress[]
  posterChoices   UserPosterChoice[]
  rewards         UserReward[]

  @@index([isFeatured, featuredOrder])
  @@index([viewCount])
  @@index([promoOrder])
}

model Genre {
  id   String @id @default(nanoid())
  name String @unique

  mangas MangaGenre[]
}

// Many-to-many join table
model MangaGenre {
  mangaId String
  genreId String

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mangaId, genreId])
}

model Chapter {
  id            String   @id @default(nanoid())
  mangaId       String
  chapterNumber Float
  title         String?
  coverImage    String?
  badgeImage    String?
  badgeScale    Int?
  // Opens of this chapter. Bumped in the same transaction as Manga.viewCount,
  // so the two move together from here on. They do not start equal: chapter
  // counts were seeded from the ReadingProgress floor after the series counter
  // had already been live, so the chapters sum to less than the series total by
  // the re-reads counted in between. That history cannot be recovered per
  // chapter, so the admin panel shows the gap rather than inventing it.
  // Admin-only, powering the breakdown in the "Үзэлт шалгах" panel.
  viewCount     Int      @default(0)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  manga           Manga             @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  pages           Page[]
  readingProgress ReadingProgress[]

  @@unique([mangaId, chapterNumber])
  @@index([mangaId])
  // Serves the "Сүүлийн шинэчлэл" chapter feed, newest first.
  @@index([publishedAt])
}

model Page {
  id         String @id @default(nanoid())
  chapterId  String
  pageNumber Int
  imageUrl   String
  width      Int?
  height     Int?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageNumber])
  @@index([chapterId])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(nanoid())
  email        String   @unique
  clerkId      String   @unique
  username     String?  @unique
  avatarUrl    String?
  role         UserRole @default(READER)
  // Denormalized cache of the current subscription expiry for a fast gate
  // check. Sourced from Subscription rows whenever a payment succeeds.
  premiumUntil DateTime?
  // The earned background this reader applied site-wide, if any.
  siteBackgroundId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratings         Rating[]
  bookmarks       Bookmark[]
  comments        Comment[]
  readingProgress ReadingProgress[]
  posterChoices   UserPosterChoice[]
  payments        Payment[]
  subscriptions   Subscription[]
  articles        Article[]
  articlesSeen    ArticleSeen[]
  notifications   UserNotification[]
  rewards         UserReward[]      @relation("RewardOwner")
  siteBackground  UserReward?       @relation("SiteBackground", fields: [siteBackgroundId], references: [id], onDelete: SetNull)
}

model Comment {
  id        String   @id @default(nanoid())
  mangaId   String
  userId    String
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manga   Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([mangaId])
  @@index([userId])
  @@index([parentId])
}

// ─── User activity ────────────────────────────────────────────────────────────

model ReadingProgress {
  id        String   @id @default(nanoid())
  userId    String
  mangaId   String
  chapterId String
  readAt    DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // One record per user per chapter; readAt tracks the most recent open.
  @@unique([userId, chapterId])
  @@index([userId, readAt])
  @@index([userId, mangaId])
  // Serves "distinct readers of this series" as an index-only scan. The
  // (userId, mangaId) index above leads with the wrong column for that.
  @@index([mangaId, userId])
}

model UserPosterChoice {
  id        String   @id @default(nanoid())
  userId    String
  mangaId   String
  posterUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  // One chosen poster per user per manga.
  @@unique([userId, mangaId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(nanoid())
  userId    String
  mangaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@index([userId])
}

model Rating {
  id        String   @id @default(nanoid())
  userId    String
  mangaId   String
  score     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@index([mangaId])
}

// ─── News (МЭДЭЭ) & rewards ─────────────────────────────────────────────────

// An admin-written post in the МЭДЭЭ feed. Everyone sees it; publishing one is
// what raises the unread badge and the one-time popup.
model Article {
  id          String   @id @default(nanoid())
  title       String
  // Markdown subset: paragraphs, **bold**, [links](https://…). See lib/markdown.
  body        String
  imageUrl    String?
  authorId    String?
  // Byline as shown, captured when written, so it survives the admin renaming
  // or leaving.
  authorName  String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  seenBy ArticleSeen[]

  @@index([publishedAt])
}

// A signed-in reader has seen this article (dismissed its popup or opened it).
// Signed-out readers keep the same state in localStorage instead.
model ArticleSeen {
  userId    String
  articleId String
  seenAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

enum NotificationKind {
  REWARD
}

// A notice for one reader, shown in their МЭДЭЭ feed next to the articles and
// counted in the same unread badge.
model UserNotification {
  id        String           @id @default(nanoid())
  userId    String
  kind      NotificationKind
  message   String
  href      String?
  // Set for REWARD notices. Unique, so a grant can never notify twice.
  rewardId  String?          @unique
  seenAt    DateTime?
  createdAt DateTime         @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward UserReward? @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A completion reward a reader earned. The image URLs and series name are
// copied at grant time, so a later change to the series' reward image never
// takes back what someone already earned. One per reader per series.
model UserReward {
  id          String   @id @default(nanoid())
  userId      String
  mangaId     String
  mangaName   String
  imageUrl    String
  originalUrl String
  grantedAt   DateTime @default(now())

  user         User              @relation("RewardOwner", fields: [userId], references: [id], onDelete: Cascade)
  manga        Manga             @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  notification UserNotification?
  appliedBy    User[]            @relation("SiteBackground")

  @@unique([userId, mangaId])
  @@index([userId, grantedAt])
}

// ─── Billing & subscriptions ────────────────────────────────────────────────

// One row per purchase attempt (audit trail for QPay invoices).
model Payment {
  id            String           @id @default(nanoid())
  userId        String
  plan          SubscriptionPlan
  amount        Int              // MNT (₮), integer
  status        PaymentStatus    @default(PENDING)
  qpayInvoiceId String?          @unique
  qpayPaymentId String?
  createdAt     DateTime         @default(now())
  paidAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?

  @@index([userId])
  @@index([status])
}

// A granted subscription period. On payment success we extend from
// max(now, current expiry) so re-purchases stack.
model Subscription {
  id        String           @id @default(nanoid())
  userId    String
  plan      SubscriptionPlan
  startedAt DateTime         @default(now())
  expiresAt DateTime
  paymentId String?          @unique
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Free-read metering ─────────────────────────────────────────────────────
// Ephemeral rows (pruned by dayKey). userId/chapterId kept as plain strings so
// this stays decoupled from content and cheap to prune. dayKey is the
// Asia/Ulaanbaatar calendar day ("YYYY-MM-DD").

// One row per free (userId, day, chapter) unlock — gives distinct counting and
// idempotency for the per-user 3/day cap.
model FreeReadUsage {
  id        String   @id @default(nanoid())
  userId    String
  ipHash    String
  dayKey    String
  chapterId String
  createdAt DateTime @default(now())

  @@unique([userId, dayKey, chapterId])
  @@index([userId, dayKey])
  @@index([dayKey])
}

// The single account that claimed an IP's free tier for a given day. Any other
// account on the same IP that day gets 0 free reads.
model IpDailyClaim {
  id        String   @id @default(nanoid())
  ipHash    String
  dayKey    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([ipHash, dayKey])
  @@index([dayKey])
}
